# ── Smart Gym API — environment variables ──────────────────────────────
# Copy this file to `.env` and adjust the values.

# Port the API server listens on
PORT=5000

# Secret used to sign JWT tokens. Use a long random string in production!
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES=7d

# ── Database ───────────────────────────────────────────────────────────
# DATA_DIR = folder where the built-in file database stores its JSON files.
# (This is the zero-setup default so the project runs anywhere.)
DATA_DIR=./data

# MONGO_URI = when you are ready to use real MongoDB, set this and follow
# the swap guide in the README ("Switching to MongoDB").
# MONGO_URI=mongodb://localhost:27017/smart_gym

# ── Frontend ───────────────────────────────────────────────────────────
# When true, the backend also serves the built React app (production mode).
SERVE_FRONTEND=true
FRONTEND_DIST=../frontend/dist

# Comma separated list of allowed CORS origins. Leave empty to reflect the
# request origin (fine for development, restrict this in production).
# CORS_ORIGIN=http://localhost:5173
